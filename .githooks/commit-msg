#!/usr/bin/env bash
#
# Valida se a mensagem de commit segue o padrão Conventional Commits.
# Tipos aceitos: feat, fix, refactor, perf, test, docs, style, chore, build, ci, revert

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|refactor|perf|test|docs|style|chore|build|ci|revert)(\([a-z0-9._-]+\))?!?: .{1,100}$"

if ! [[ "$COMMIT_MSG" =~ $PATTERN ]]; then
  echo ""
  echo "❌ Commit rejeitado: mensagem fora do padrão."
  echo ""
  echo "Formato esperado:"
  echo "  <tipo>(<escopo opcional>): <descrição curta>"
  echo ""
  echo "Tipos aceitos:"
  echo "  feat      Nova funcionalidade"
  echo "  fix       Correção de bug"
  echo "  refactor  Mudança de código sem alterar comportamento externo"
  echo "  perf      Melhoria de performance"
  echo "  test      Adição ou ajuste de testes"
  echo "  docs      Documentação (README, comentários XML, Swagger)"
  echo "  style     Formatação, espaçamento — sem mudança de lógica"
  echo "  chore     Build, dependências, configs (.csproj, nuget.config)"
  echo "  build     Mudanças no processo de build"
  echo "  ci        Pipelines (GitHub Actions, Azure DevOps)"
  echo "  revert    Reversão de um commit anterior"
  echo ""
  echo "Exemplos:"
  echo "  feat(customer): adiciona validação de CNPJ no CustomerService"
  echo "  fix(orders): corrige NullReferenceException ao calcular total do pedido"
  echo ""
  echo "Sua mensagem foi:"
  echo "  \"$COMMIT_MSG\""
  echo ""
  exit 1
fi

exit 0
